<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="430" viewBox="0 0 1000 430">
<rect width="1000" height="430" fill="white"/>
<text x="500" y="45" text-anchor="middle" font-family="Arial" font-size="28" font-weight="bold">Kafka Publish–Subscribe Model</text>
<rect x="70" y="130" width="180" height="90" rx="12" fill="none" stroke="black" stroke-width="2"/>
<text x="160" y="165" text-anchor="middle" font-family="Arial" font-size="20">Producer</text>
<text x="160" y="195" text-anchor="middle" font-family="Arial" font-size="15">publish</text>
<line x1="250" y1="175" x2="380" y2="175" stroke="black" stroke-width="2"/>
<polygon points="380,175 365,167 365,183" fill="black"/>
<rect x="380" y="105" width="240" height="140" rx="12" fill="none" stroke="black" stroke-width="2"/>
<text x="500" y="145" text-anchor="middle" font-family="Arial" font-size="20" font-weight="bold">Topic</text>
<text x="500" y="175" text-anchor="middle" font-family="Arial" font-size="16">retained records</text>
<text x="500" y="205" text-anchor="middle" font-family="Arial" font-size="16">partitioned log</text>
<line x1="620" y1="145" x2="760" y2="105" stroke="black" stroke-width="2"/>
<line x1="620" y1="205" x2="760" y2="245" stroke="black" stroke-width="2"/>
<polygon points="760,105 745,100 750,115" fill="black"/>
<polygon points="760,245 750,235 745,250" fill="black"/>
<rect x="760" y="60" width="180" height="80" rx="12" fill="none" stroke="black" stroke-width="2"/>
<text x="850" y="95" text-anchor="middle" font-family="Arial" font-size="18">Consumer A</text>
<rect x="760" y="205" width="180" height="80" rx="12" fill="none" stroke="black" stroke-width="2"/>
<text x="850" y="240" text-anchor="middle" font-family="Arial" font-size="18">Consumer B</text>
<text x="500" y="355" text-anchor="middle" font-family="Arial" font-size="18">Multiple consumers can independently read retained records.</text>
</svg>
<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="520" viewBox="0 0 1000 520">
<rect width="1000" height="520" fill="white"/>
<text x="500" y="45" text-anchor="middle" font-family="Arial" font-size="28" font-weight="bold">Kafka — High-Level Architecture</text>
<rect x="50" y="110" width="180" height="90" rx="12" fill="none" stroke="black" stroke-width="2"/>
<text x="140" y="145" text-anchor="middle" font-family="Arial" font-size="20">Producer</text>
<text x="140" y="175" text-anchor="middle" font-family="Arial" font-size="15">publishes records</text>
<line x1="230" y1="155" x2="340" y2="155" stroke="black" stroke-width="2"/>
<polygon points="340,155 325,147 325,163" fill="black"/>
<rect x="340" y="80" width="300" height="260" rx="14" fill="none" stroke="black" stroke-width="2"/>
<text x="490" y="112" text-anchor="middle" font-family="Arial" font-size="21" font-weight="bold">Kafka Cluster</text>
<rect x="370" y="135" width="240" height="55" rx="8" fill="none" stroke="black"/>
<text x="490" y="169" text-anchor="middle" font-family="Arial" font-size="17">Broker 1 — Topic / Partitions</text>
<rect x="370" y="205" width="240" height="55" rx="8" fill="none" stroke="black"/>
<text x="490" y="239" text-anchor="middle" font-family="Arial" font-size="17">Broker 2 — Replicas</text>
<rect x="370" y="275" width="240" height="55" rx="8" fill="none" stroke="black"/>
<text x="490" y="309" text-anchor="middle" font-family="Arial" font-size="17">Broker 3 — Replicas</text>
<line x1="640" y1="155" x2="750" y2="155" stroke="black" stroke-width="2"/>
<polygon points="750,155 735,147 735,163" fill="black"/>
<rect x="750" y="110" width="200" height="90" rx="12" fill="none" stroke="black" stroke-width="2"/>
<text x="850" y="145" text-anchor="middle" font-family="Arial" font-size="20">Consumer</text>
<text x="850" y="175" text-anchor="middle" font-family="Arial" font-size="15">reads records</text>
<text x="500" y="405" text-anchor="middle" font-family="Arial" font-size="18">Topics are split into partitions; partitions are distributed across brokers.</text>
<text x="500" y="435" text-anchor="middle" font-family="Arial" font-size="18">Replication provides fault tolerance, while consumers track offsets.</text>
</svg>
<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="430" viewBox="0 0 1000 430">
<rect width="1000" height="430" fill="white"/>
<text x="500" y="45" text-anchor="middle" font-family="Arial" font-size="28" font-weight="bold">Kafka Partition as an Append-Only Log</text>
<text x="70" y="105" font-family="Arial" font-size="18">Offset</text>
<g font-family="Arial" font-size="17">
<rect x="150" y="75" width="120" height="70" fill="none" stroke="black"/><text x="210" y="117" text-anchor="middle">0 : A</text>
<rect x="270" y="75" width="120" height="70" fill="none" stroke="black"/><text x="330" y="117" text-anchor="middle">1 : B</text>
<rect x="390" y="75" width="120" height="70" fill="none" stroke="black"/><text x="450" y="117" text-anchor="middle">2 : C</text>
<rect x="510" y="75" width="120" height="70" fill="none" stroke="black"/><text x="570" y="117" text-anchor="middle">3 : D</text>
<rect x="630" y="75" width="120" height="70" fill="none" stroke="black"/><text x="690" y="117" text-anchor="middle">4 : E</text>
<rect x="750" y="75" width="120" height="70" fill="none" stroke="black"/><text x="810" y="117" text-anchor="middle">5 : F</text>
</g>
<line x1="150" y1="185" x2="870" y2="185" stroke="black" stroke-width="3"/>
<text x="510" y="225" text-anchor="middle" font-family="Arial" font-size="18">Records are appended; offsets identify positions within a partition.</text>
<text x="510" y="270" text-anchor="middle" font-family="Arial" font-size="18">A consumer can resume from a previously committed offset.</text>
<text x="510" y="330" text-anchor="middle" font-family="Arial" font-size="18">Retention controls how long records remain available.</text>
</svg>
